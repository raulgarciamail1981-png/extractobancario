# Copiar este archivo a ".env" (sin el .example) y completar los valores
# reales antes de "docker compose up". El ".env" NO se sube al repositorio.

# Clave de sesión de Flask. Generar una fuerte y fija, ej. con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si cambia, se cierra la sesión de todos los usuarios conectados.
SECRET_KEY=

# Credenciales de la base Postgres (las define este archivo, Postgres las
# usa para crear el usuario/base la primera vez que levanta el contenedor).
POSTGRES_USER=conciliador
POSTGRES_PASSWORD=
POSTGRES_DB=conciliador

# Dominio propio que apunta por DNS (registro A) a la IP del VPS. Caddy lo
# usa para pedir el certificado HTTPS automáticamente.
DOMAIN=conciliador.tuempresa.com
